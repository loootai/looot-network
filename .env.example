# Demo mode: set to 1 to run on 200 invented people with no Supabase project and no looot token.
# Demo has no sign-in and refuses to start while LOOOT_TOKEN is set.
NEXT_PUBLIC_DEMO=

# Supabase project settings (Project Settings, API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.example.invalid
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Who may use the network (required outside demo). Comma separated, case-insensitive, exact match.
# With both empty the app shows a setup page and refuses data, settings and spending.
LOOOT_NETWORK_ALLOWED_EMAILS=you@example.com
LOOOT_NETWORK_ALLOWED_DOMAINS=

# Granola meeting import (optional). Needs a Granola Business plan. Create a key in Granola under
# Settings, Connectors, API keys. Server only, never sent to the browser or to looot.
GRANOLA_API_KEY=

# Paid enrichment is off until you set both of these. Server only, never sent to the browser.
# Create a token at https://looot.ai/settings with catalog.read, runs.read and runs.execute.
LOOOT_NETWORK_ENRICH=
LOOOT_TOKEN=
# Optional, defaults to https://api.looot.ai
LOOOT_API_URL=

# Spending limits set by the operator. The browser cannot change them.
# Most one run may spend, in dollars (default 1) and most people one run may cover (default 200).
LOOOT_NETWORK_CAP_USD=1
LOOOT_NETWORK_MAX_PEOPLE=200
# Calls per user per minute to the quote and enrich routes (default 30)
SPEND_RATE_LIMIT_PER_MIN=30
# Starting daily and monthly budget for the CLI until saved (the web app keeps its own in Supabase)
# LOOOT_NETWORK_DAILY_USD=5
# LOOOT_NETWORK_MONTHLY_USD=25
# Folder for the CLI budget file (default .looot-network)
# LOOOT_NETWORK_DIR=
